# ==============================================================================
# Tessera Sync Relay & Authentication Server Configuration
# ==============================================================================

# Network Binding
PORT=8787
HOST=0.0.0.0

# 256-bit Hex secret for signing JWT access and 2FA challenge tokens.
# Set this so tokens persist across server restarts.
# You can generate one with: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string

# SQLite Database Storage Directory (defaults to ./data relative to server root)
DATA_DIR=./data

# CORS Allowed Origin (defaults to http://localhost:5173 for web dev)
CORS_ORIGIN=http://localhost:5173
